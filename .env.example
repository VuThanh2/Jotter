# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.

# ---------- Postgres (docker-compose) ----------
POSTGRES_DB=jotter
POSTGRES_USER=jotter
POSTGRES_PASSWORD=change-me

# ---------- Backend ----------
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=jotter;Username=jotter;Password=change-me

Jwt__Issuer=jotter
Jwt__Audience=jotter-app
# Tối thiểu 32 ký tự ngẫu nhiên, vd. `openssl rand -base64 48`. Thiếu thì API dừng ngay lúc khởi động.
Jwt__Secret=

# Để trống Email__Host thì email (mã kích hoạt, mã đặt lại mật khẩu) chỉ được ghi ra log của API.
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__From=

Storage__RootPath=./uploads

# Claude (console.anthropic.com) cho tóm tắt + hỏi đáp; Voyage AI (voyageai.com) cho embedding.
# Thiếu khoá thì tính năng AI trả 503 LlmUnavailable, phần còn lại vẫn chạy bình thường.
Llm__ApiKey=
Llm__EmbeddingApiKey=
# Tuỳ chọn: mặc định claude-haiku-5-5 (rẻ nhất); cần chất lượng cao hơn thì đặt claude-sonnet-5-5.
# Llm__Model=claude-haiku-5-5

Cors__AllowedOrigins__0=http://localhost:3000
