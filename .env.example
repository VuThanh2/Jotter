# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.

# ---------- Postgres (docker-compose) ----------
POSTGRES_DB=jotter
POSTGRES_USER=jotter
POSTGRES_PASSWORD=change-me

# ---------- Backend ----------
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=jotter;Username=jotter;Password=change-me

Jwt__Issuer=jotter
Jwt__Audience=jotter-app
Jwt__Secret=

Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__From=

Storage__RootPath=./uploads

Llm__ApiKey=

Cors__AllowedOrigins__0=http://localhost:3000
