# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.

# ---------- Postgres (docker-compose) ----------
POSTGRES_DB=jotter
POSTGRES_USER=jotter
POSTGRES_PASSWORD=change-me

# ---------- Backend ----------
# Tuỳ chọn: cổng host của container api (mặc định 8080), đổi khi máy đã có tiến trình khác chiếm 8080.
# API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=jotter;Username=jotter;Password=change-me

Jwt__Issuer=jotter
Jwt__Audience=jotter-app
# Tối thiểu 32 ký tự ngẫu nhiên, vd. `openssl rand -base64 48`. Thiếu thì API dừng ngay lúc khởi động.
Jwt__Secret=

# Để trống Email__Host thì email (mã kích hoạt, mã đặt lại mật khẩu) chỉ được ghi ra log của API.
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__From=

Storage__RootPath=./uploads

# Gemini API (aistudio.google.com/apikey): một khoá dùng cho cả tóm tắt, hỏi đáp và embedding.
# Thiếu khoá thì tính năng AI trả 503 LlmUnavailable, phần còn lại vẫn chạy bình thường.
Llm__ApiKey=
# Tuỳ chọn (đều có trong free tier): mặc định gemini-3.5-flash-lite (nhanh); gemini-3.8-flash tốt hơn nhưng
# ở free tier thường chậm 20–60 giây và hay quá tải.
# Llm__Model=gemini-3.5-flash-lite
# Llm__EmbeddingModel=gemini-embedding-2

Cors__AllowedOrigins__0=http://localhost:3000
